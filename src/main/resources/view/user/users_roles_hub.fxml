<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" styleClass="main-content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.user.UsersRolesHubController">
    
    <stylesheets>
        <URL value="@/styles/main.css" />
        <URL value="@/styles/components/estetica.css" />
        <URL value="@/styles/components/hubs.css" />
    </stylesheets>

    <children>
        <!-- Common Header for the Hub -->
        <VBox styleClass="view-header" spacing="0">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <StackPane styleClass="view-header-icon-wrap" style="-fx-background-color: #3b82f6;">
                            <children><FontAwesomeIconView glyphName="SHIELD" size="24" fill="white"/></children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label text="%security.hub.title" styleClass="view-title"/>
                                <Label text="%security.hub.subtitle" styleClass="view-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Custom Navigation Bar -->
        <HBox styleClass="hub-nav-container">
            <children>
                <HBox styleClass="hub-nav-bar">
                    <children>
                        <Button fx:id="btnTabUsers" onAction="#showUsers" styleClass="hub-nav-button, hub-nav-button-active" text="%security.hub.tab.users" focusTraversable="false">
                            <graphic><FontAwesomeIconView glyphName="USERS" size="14"/></graphic>
                        </Button>
                        <Button fx:id="btnTabRoles" onAction="#showRoles" styleClass="hub-nav-button" text="%security.hub.tab.roles" focusTraversable="false">
                            <graphic><FontAwesomeIconView glyphName="ID_BADGE" size="14"/></graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Content Container (StackPane to switch views) -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="hub-content-area">
            <children>
                <fx:include fx:id="manageUsers" source="manage_users.fxml" />
                <fx:include fx:id="manageRoles" source="manage_roles.fxml" visible="false" />
            </children>
        </StackPane>
    </children>
</VBox>
