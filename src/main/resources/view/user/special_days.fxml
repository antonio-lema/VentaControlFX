<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" prefWidth="650" prefHeight="650" styleClass="modal-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.user.SpecialDaysController">
    
    <!-- Modal Header -->
    <VBox styleClass="modal-header">
        <padding>
            <Insets top="24" right="32" bottom="24" left="32"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <StackPane styleClass="icon-container-blue" maxWidth="45" maxHeight="45" style="-fx-background-color: rgba(139, 92, 246, 0.1);">
                <FontAwesomeIconView glyphName="CALENDAR_ALT" size="20" fill="#8b5cf6" />
            </StackPane>
            <VBox spacing="2">
                <Label text="%special.days.title" styleClass="modal-title" />
                <Label text="%special.days.subtitle" styleClass="modal-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleCancel" styleClass="button-ghost" text="&#x2715;" style="-fx-font-size: 16px;"/>
        </HBox>
    </VBox>

    <Separator/>

    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" right="32" bottom="24" left="32"/>
        </padding>
        
        <!-- Add New Exception Card -->
        <VBox spacing="15" styleClass="config-card">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="A&#x00d1;DIR NUEVA EXCEPCI&#x00d3;N" styleClass="text-xs, font-bold, text-gray-400" />
            
            <HBox spacing="15" alignment="BOTTOM_LEFT">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="%special.days.field.date" styleClass="text-sm, font-medium" />
                    <DatePicker fx:id="pickerDate" promptText="Seleccionar fecha" maxWidth="Infinity" styleClass="modern-input-field" />
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="%special.days.field.reason" styleClass="text-sm, font-medium" />
                    <TextField fx:id="txtReason" promptText="%special.days.field.reason.prompt" styleClass="modern-input-field" />
                </VBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkClosed" text="%special.days.check.closed" selected="true" styleClass="modern-checkbox" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="%special.days.btn.add" onAction="#handleAdd" styleClass="btn-primary">
                    <graphic><FontAwesomeIconView glyphName="PLUS" fill="white" /></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- List Section -->
        <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="%special.days.list.title" styleClass="card-title-small" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRemove" styleClass="btn-icon-danger" style="-fx-padding: 5;">
                    <graphic><FontAwesomeIconView glyphName="TRASH" size="14" fill="#ef4444" /></graphic>
                    <tooltip><Tooltip text="%special.days.btn.delete"/></tooltip>
                </Button>
            </HBox>
            <TableView fx:id="tableSpecials" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colDate" text="FECHA" prefWidth="120" />
                    <TableColumn fx:id="colReason" text="MOTIVO / DESCRIPCIÓN" prefWidth="300" />
                    <TableColumn fx:id="colStatus" text="ESTADO" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <Separator/>

    <!-- Footer Actions -->
    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="modal-footer">
        <padding>
            <Insets top="20" right="32" bottom="20" left="32"/>
        </padding>
        <Button text="Cerrar y Volver" onAction="#handleSave" styleClass="btn-primary" prefWidth="200">
            <graphic><FontAwesomeIconView glyphName="CHECK" size="14" fill="white" /></graphic>
        </Button>
    </HBox>

    <stylesheets>
        <URL value="@/styles/variables.css" />
        <URL value="@/styles/components/work_sessions.css" />
    </stylesheets>
</VBox>
