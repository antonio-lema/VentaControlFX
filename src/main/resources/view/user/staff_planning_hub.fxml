<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" styleClass="main-content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.user.StaffPlanningHubController">
    
    <stylesheets>
        <URL value="@/styles/main.css" />
        <URL value="@/styles/components/estetica.css" />
        <URL value="@/styles/components/hubs.css" />
    </stylesheets>

    <children>
        <!-- Common Header -->
        <VBox styleClass="view-header" spacing="0">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <StackPane styleClass="view-header-icon-wrap" style="-fx-background-color: #8b5cf6;">
                            <children><FontAwesomeIconView glyphName="CALENDAR" size="24" fill="white"/></children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label text="%staff.planning.hub.title" styleClass="view-title"/>
                                <Label text="%staff.planning.hub.subtitle" styleClass="view-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Custom Navigation Bar -->
        <HBox styleClass="hub-nav-container">
            <children>
                <HBox styleClass="hub-nav-bar">
                    <children>
                        <Button fx:id="btnTabCalendar" onAction="#showCalendar" styleClass="hub-nav-button, hub-nav-button-active" text="%staff.planning.tab.calendar">
                            <graphic><FontAwesomeIconView glyphName="CALENDAR_ALT" size="14"/></graphic>
                        </Button>
                        <Button fx:id="btnTabBusinessHours" onAction="#showBusinessHours" styleClass="hub-nav-button" text="%staff.planning.tab.hours">
                            <graphic><FontAwesomeIconView glyphName="CLOCK_ALT" size="14"/></graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Content Area -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="hub-content-area">
            <children>
                <fx:include fx:id="staffCalendar" source="staff_calendar.fxml" />
                <fx:include fx:id="businessHours" source="business_hours.fxml" visible="false" />
            </children>
        </StackPane>
    </children>
</VBox>
