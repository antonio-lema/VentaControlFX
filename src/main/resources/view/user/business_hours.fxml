<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" prefWidth="900" prefHeight="750" styleClass="modal-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.dialog.BusinessHoursController">
    
    <ScrollPane fitToWidth="true" styleClass="modal-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="20" styleClass="modal-content-padding">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <!-- Save Action Bar -->
            <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 0 0 15 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <children>
                    <Label text="HORARIOS DE APERTURA" style="-fx-font-weight: 800; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-letter-spacing: 1px;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Guardar Cambios" onAction="#handleSave" styleClass="btn-primary" prefWidth="180">
                        <graphic><FontAwesomeIconView glyphName="CHECK_CIRCLE" size="14" fill="white" /></graphic>
                    </Button>
                </children>
            </HBox>
            
            <!-- Schedule Grid -->
            <VBox styleClass="config-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <GridPane fx:id="gridSchedule" hgap="25" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" halignment="LEFT" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints minWidth="200" halignment="RIGHT" />
                    </columnConstraints>
                    <!-- Rows added dynamically -->
                </GridPane>
            </VBox>

            <!-- Grace Period Settings -->
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="config-card" style="-fx-padding: 20;">
                <children>
                    <StackPane styleClass="icon-container-small" style="-fx-background-color: rgba(245, 158, 11, 0.1); -fx-padding: 10; -fx-background-radius: 8px;">
                        <FontAwesomeIconView glyphName="INFO_CIRCLE" size="16" fill="#f59e0b" />
                    </StackPane>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Margen de cortesía operativa" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Tiempo permitido antes de marcar un retraso:" styleClass="text-gray-500" />
                            <TextField fx:id="txtGracePeriod" prefWidth="60" styleClass="modern-input-field" alignment="CENTER" />
                            <Label text="minutos" styleClass="text-gray-500" />
                        </HBox>
                    </VBox>
                </children>
            </HBox>

            <Separator style="-fx-padding: 10 0;"/>

            <!-- Special Days / Exceptions Section -->
            <VBox spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="icon-container-small" style="-fx-background-color: rgba(139, 92, 246, 0.1);">
                        <FontAwesomeIconView glyphName="CALENDAR_ALT" size="14" fill="#8b5cf6" />
                    </StackPane>
                    <Label text="DÍAS ESPECIALES / FESTIVOS LOCALES" style="-fx-font-weight: 800; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-letter-spacing: 1px;" />
                </HBox>

                <!-- Add New Exception Card -->
                <VBox spacing="15" styleClass="config-card" style="-fx-background-color: #f8fafc;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox spacing="15" alignment="BOTTOM_LEFT">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="%special.days.field.date" styleClass="text-sm, font-medium" />
                            <DatePicker fx:id="pickerDate" promptText="Seleccionar fecha" maxWidth="Infinity" styleClass="modern-input-field" />
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="%special.days.field.reason" styleClass="text-sm, font-medium" />
                            <TextField fx:id="txtReason" promptText="%special.days.field.reason.prompt" styleClass="modern-input-field" />
                        </VBox>
                        <VBox spacing="8">
                             <CheckBox fx:id="chkClosed" text="%special.days.check.closed" selected="true" styleClass="modern-checkbox" />
                        </VBox>
                        <Button text="%special.days.btn.add" onAction="#handleAddSpecialDay" styleClass="btn-primary" prefHeight="40">
                            <graphic><FontAwesomeIconView glyphName="PLUS" fill="white" /></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Exceptions Table -->
                <VBox spacing="10" styleClass="table-card">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%special.days.list.title" styleClass="card-title-small" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Eliminar" onAction="#handleRemoveSpecialDay" styleClass="btn-danger">
                            <graphic><FontAwesomeIconView glyphName="TRASH" size="14" fill="#ef4444" /></graphic>
                        </Button>
                    </HBox>
                    <TableView fx:id="tableSpecials" prefHeight="200" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colDate" text="FECHA" prefWidth="150" />
                            <TableColumn fx:id="colReason" text="MOTIVO / DESCRIPCIÓN" prefWidth="400" />
                            <TableColumn fx:id="colStatus" text="ESTADO" prefWidth="120" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <stylesheets>
        <URL value="@/styles/variables.css" />
        <URL value="@/styles/components/work_sessions.css" />
    </stylesheets>
</VBox>
