<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" styleClass="main-content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.product.CatalogController">
    
    <stylesheets>
        <URL value="@/styles/main.css" />
        <URL value="@/styles/components/estetica.css" />
        <URL value="@/styles/components/hubs.css" />
    </stylesheets>

    <children>
        <!-- Common Header -->
        <VBox styleClass="view-header" spacing="0">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <StackPane styleClass="view-header-icon-wrap" style="-fx-background-color: #f59e0b;">
                            <children><FontAwesomeIconView glyphName="BOOK" size="24" fill="white"/></children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label text="%catalog.hub.title" styleClass="view-title"/>
                                <Label text="%catalog.hub.subtitle" styleClass="view-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Custom Navigation Bar -->
        <HBox styleClass="hub-nav-container">
            <children>
                <HBox styleClass="hub-nav-bar">
                    <children>
                        <Button fx:id="btnTabProducts" onAction="#showProducts" styleClass="hub-nav-button, hub-nav-button-active" text="%catalog.tab.products">
                            <graphic><FontAwesomeIconView glyphName="CUBES" size="14"/></graphic>
                        </Button>
                        <Button fx:id="btnTabCategories" onAction="#showCategories" styleClass="hub-nav-button" text="%catalog.tab.categories">
                            <graphic><FontAwesomeIconView glyphName="TAGS" size="14"/></graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Content Area -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="hub-content-area">
            <children>
                <fx:include fx:id="productsView" source="products.fxml" />
                <fx:include fx:id="categoriesView" source="categories.fxml" visible="false" />
            </children>
        </StackPane>
    </children>
</VBox>
