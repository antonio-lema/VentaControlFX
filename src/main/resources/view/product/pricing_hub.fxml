<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox spacing="0" styleClass="main-content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.ventacontrolfx.presentation.controller.product.PricingHubController">
    
    <stylesheets>
        <URL value="@/styles/main.css" />
        <URL value="@/styles/components/estetica.css" />
        <URL value="@/styles/components/hubs.css" />
    </stylesheets>

    <children>
        <!-- Common Header -->
        <VBox styleClass="view-header" spacing="0">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <StackPane styleClass="view-header-icon-wrap" style="-fx-background-color: #10b981;">
                            <children><FontAwesomeIconView glyphName="MONEY" size="24" fill="white"/></children>
                        </StackPane>
                        <VBox spacing="2">
                            <children>
                                <Label text="%pricing.hub.title" styleClass="view-title"/>
                                <Label text="%pricing.hub.subtitle" styleClass="view-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Custom Navigation Bar -->
        <HBox styleClass="hub-nav-container">
            <children>
                <HBox styleClass="hub-nav-bar">
                    <children>
                        <Button fx:id="btnTabLists" onAction="#showPriceLists" styleClass="hub-nav-button, hub-nav-button-active" text="%pricing.tab.lists">
                            <graphic><FontAwesomeIconView glyphName="LIST_ALT" size="14"/></graphic>
                        </Button>
                        <Button fx:id="btnTabPromos" onAction="#showPromotions" styleClass="hub-nav-button" text="%pricing.tab.promos">
                            <graphic><FontAwesomeIconView glyphName="PERCENT" size="14"/></graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Content Area -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="hub-content-area">
            <children>
                <fx:include fx:id="priceLists" source="/view/dialog/price_lists.fxml" />
                <fx:include fx:id="promotions" source="/view/dialog/promotions.fxml" visible="false" />
            </children>
        </StackPane>
    </children>
</VBox>
