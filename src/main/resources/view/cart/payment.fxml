<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<BorderPane prefHeight="700.0" prefWidth="500.0" styleClass="payment-root"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ventacontrolfx.presentation.controller.dialog.PaymentController">
    <fx:define>
        <ToggleGroup fx:id="tgPaymentMethod"/>
    </fx:define>
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="payment-header">
         <Label text="%payment.title" styleClass="payment-header-title" />
         <Region HBox.hgrow="ALWAYS" />
         <Button onAction="#handleClose" styleClass="btn-icon" cancelButton="true">
            <graphic>
                <FontAwesomeIconView glyphName="CLOSE" size="20" styleClass="icon-white" />
            </graphic>
         </Button>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="detail-scroll" vbarPolicy="AS_NEEDED">
         <content>
            <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="payment-body">
               <!-- Total Display -->
                <VBox alignment="CENTER" spacing="5.0">
                   <Label fx:id="lblTotalAmount" text="34,99 &#x20ac;" styleClass="payment-total-amount" />
                   <Label text="%payment.total_to_charge" styleClass="label-muted" />
                   <padding><Insets bottom="10.0" top="10.0" /></padding>
                </VBox>

                <!-- Payment Method Selector -->
                <VBox spacing="8" alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                    <Label text="%payment.selector.label" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: -fx-text-custom-muted;" />
                    <HBox alignment="CENTER">
                        <HBox styleClass="segmented-control">
                            <ToggleButton fx:id="btnPayCash" text="%payment.method.cash" minWidth="100" toggleGroup="$tgPaymentMethod" selected="true" />
                            <ToggleButton fx:id="btnPayCard" text="%payment.method.card" minWidth="100" toggleGroup="$tgPaymentMethod" />
                            <ToggleButton fx:id="btnPayMixed" text="%payment.method.mixed" minWidth="100" toggleGroup="$tgPaymentMethod" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Amount Section (Visible for Cash/Mixed) -->
                <VBox fx:id="amountSection" spacing="15.0" styleClass="payment-method-card" style="-fx-padding: 20;">
                   <HBox alignment="CENTER_LEFT" spacing="10.0">
                      <FontAwesomeIconView glyphName="MONEY" size="18" styleClass="icon-primary" />
                      <Label fx:id="lblAmountTitle" text="%payment.amount_given" styleClass="payment-method-label" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="lblAmountValue" text="0.00 &#x20ac;" styleClass="badge-primary" />
                   </HBox>
                   
                   <VBox spacing="15">
                       <TextField fx:id="txtGivenAmount" promptText="0.00"
                                  styleClass="modern-input-field payment-amount-field"
                                  maxWidth="Infinity" />

                       <!-- Quick Buttons -->
                       <GridPane fx:id="gridQuickButtons" hgap="10.0" vgap="10.0" styleClass="quick-money-grid">
                         <columnConstraints>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                         </columnConstraints>
                         <rowConstraints>
                           <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                         </rowConstraints>
                          <Button fx:id="btnQuick1" text="35 &#x20ac;" maxWidth="Infinity" maxHeight="Infinity"
                                  onAction="#handleQuickMoney" styleClass="btn-primary" />
                          <Button fx:id="btnQuick2" text="36 &#x20ac;" maxWidth="Infinity" maxHeight="Infinity"
                                  onAction="#handleQuickMoney" styleClass="btn-primary" GridPane.columnIndex="1" />
                          <Button fx:id="btnQuick3" text="40 &#x20ac;" maxWidth="Infinity" maxHeight="Infinity"
                                  onAction="#handleQuickMoney" styleClass="btn-primary" GridPane.columnIndex="2" />
                          <Button fx:id="btnQuick4" text="50 &#x20ac;" maxWidth="Infinity" maxHeight="Infinity"
                                  onAction="#handleQuickMoney" styleClass="btn-primary" GridPane.columnIndex="3" />
                       </GridPane>
                   </VBox>
                </VBox>

                <!-- Card Instruction View (Visible for Card only) -->
                <VBox fx:id="cardInstructionView" managed="false" visible="false" spacing="20" styleClass="card-instruction-view">
                    <FontAwesomeIconView glyphName="CREDIT_CARD" size="80" styleClass="card-instruction-icon" />
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="%payment.card.waiting" styleClass="card-instruction-text" />
                        <Label text="%payment.card.instruction" styleClass="card-instruction-subtext" />
                    </VBox>
                </VBox>

                <!-- Warning Message -->
                <VBox fx:id="vboxCashWarning" managed="false" visible="false" alignment="CENTER" spacing="10" style="-fx-padding: 10 20; -fx-background-color: rgba(239, 68, 68, 0.1); -fx-background-radius: 8; -fx-border-color: #ef4444; -fx-border-width: 1; -fx-border-radius: 8;">
                    <HBox alignment="CENTER" spacing="10">
                        <FontAwesomeIconView glyphName="EXCLAMATION_TRIANGLE" size="18" fill="#ef4444" />
                        <Label fx:id="lblCashWarning" text="%payment.warning.card_only" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" wrapText="true" />
                    </HBox>
                </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
    <bottom>
        <VBox spacing="12" styleClass="payment-footer">
            <Button fx:id="btnConfirmPay" text="%payment.btn.pay_now" onAction="#handleConfirmPayment"
                    maxWidth="Infinity" styleClass="btn-confirm-payment" graphicTextGap="15">
                <graphic>
                    <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="22" fill="white" />
                </graphic>
            </Button>
            <Button text="%payment.btn.cancel" onAction="#handleClose"
                    maxWidth="Infinity" styleClass="btn-secondary" cancelButton="true" />
        </VBox>
    </bottom>
    <stylesheets>
        <URL value="@../../styles/components/payment.css" />
    </stylesheets>
</BorderPane>
