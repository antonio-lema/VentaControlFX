<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<StackPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" spacing="20.0">
         <children>
            <StackPane style="-fx-background-color: #f1f5f9; -fx-background-radius: 50; -fx-padding: 30;">
               <children>
                  <FontAwesomeIconView fill="#6366f1" glyphName="ROCKET" size="80" />
               </children>
               <maxWidth>150</maxWidth>
            </StackPane>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="VentaControlFX">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Text>
                  <Text fill="#64748b" strokeType="OUTSIDE" strokeWidth="0.0" text="Cargando sistema y base de datos...">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Text>
               </children>
            </VBox>
            <ProgressBar prefWidth="300.0" style="-fx-accent: #6366f1; -fx-control-inner-background: #f1f5f9; -fx-background-color: transparent;" />
         </children>
      </VBox>
   </children>
</StackPane>
