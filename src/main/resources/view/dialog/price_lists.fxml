<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" styleClass="main-content-area" style="-fx-padding: 0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ventacontrolfx.presentation.controller.dialog.PriceListController">
    <VBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 25 35;">
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="LISTAS DE PRECIOS" style="-fx-font-weight: 800; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-letter-spacing: 1px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Nueva Tarifa" onAction="#openNewPriceListForm" styleClass="btn-primary">
                    <graphic><FontAwesomeIconView glyphName="PLUS" size="14" fill="WHITE"/></graphic>
                </Button>
            </children>
        </HBox>
        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblCount" text="0 tarifas registradas" styleClass="metric-value-small, text-muted"/>
        </HBox>

        <!-- Content area -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="edge-to-edge">
            <FlowPane fx:id="priceListsContainer" hgap="20" vgap="20" prefWrapLength="800">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <!-- Las tarjetas de tarifas se generar&#x00e1;n aqu&#x00ed; din&#x00e1;micamente -->
            </FlowPane>
        </ScrollPane>
    </VBox>
</VBox>
